{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "../vite.config.*",
    "../vitest.config.*",
    "../cypress.config.*",
    "../playwright.config.*",
    "../eslint.config.*"
  ],
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
